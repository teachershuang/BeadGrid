{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeadGrid",
  "version": "1.0.2",
  "identifier": "com.teachershuang.beadgrid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeadGrid",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "离线拼豆图纸生成与修图工具",
    "longDescription": "把普通图片转换为带色号、坐标和底板分界的拼豆图纸，支持手工修图、工程保存、采购清单和打印版 PDF。",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
