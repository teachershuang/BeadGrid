{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeadGrid",
  "version": "0.1.0",
  "identifier": "com.teachershuang.beadgrid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeadGrid",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "拼豆底稿生成工具",
    "longDescription": "离线运行的拼豆底稿、分色图、采购清单与底板拆分图生成工具。",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
